---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { rooms, site, type Room } from '../../data/site';
import images from '../../data/images.generated.json';
export function getStaticPaths() {
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}
interface Props {
  room: Room;
}
const { room } = Astro.props;
---

<Layout
  title={`${room.name} 객실 | 화양계곡 능운대펜션`}
  description={`${room.name} 객실의 사진과 공간 안내. ${room.structure}, 약 ${room.pyeong}평의 온돌 객실입니다. 날짜별 요금과 예약 가능 여부는 떠나요에서 확인하세요.`}
>
  <div class="container page-bottom">
    <nav class="breadcrumbs" aria-label="현재 위치">
      <a href="/">홈</a>
      <span>/</span>
      <a href="/rooms/">객실</a>
      <span>/</span>
      <span>{room.name}</span>
    </nav>
    <header class="room-detail-head">
      <div>
        <span class="eyebrow">
          ROOM {room.number} · {room.structure}
        </span>
        <h1>{room.name}</h1>
      </div>
      <p>{room.introduction}</p>
    </header>
    <div class="room-detail-grid">
      <Gallery photos={room.gallery} name={room.name} />
      <aside class="room-aside" aria-label="객실 정보와 예약">
        <span class="eyebrow">ROOM DETAILS</span>
        <h2>객실 안내</h2>
        <p>{room.description}</p>
        <dl class="room-facts">
          <div>
            <dt>
              <Icon name="people" size={16} />
              인원
            </dt>
            <dd>
              기준 {room.standard}인<small>최대 {room.maximum}인</small>
            </dd>
          </div>
          <div>
            <dt>
              <Icon name="area" size={16} />
              객실 크기
            </dt>
            <dd>약 {room.pyeong}평</dd>
          </div>
          <div>
            <dt>
              <Icon name="home" size={16} />
              객실 구성
            </dt>
            <dd>{room.structure}</dd>
          </div>
          <div>
            <dt>
              <Icon name="clock" size={16} />
              입실 / 퇴실
            </dt>
            <dd>15:00 / 11:00</dd>
          </div>
        </dl>
        <p class="fine-print">
          날짜별 요금과 예약 가능 여부는 떠나요에서 확인해 주세요. 인원 추가 기준과 요금도 함께
          안내됩니다.
        </p>
        <Button href={site.bookingUrl} external icon="diagonal">
          요금 확인 · 숙박 예약
        </Button>
        <p class="room-help">
          객실 문의 <a href={site.phoneHref}>{site.phone}</a>
        </p>
      </aside>
    </div>
    <section class="room-notes" aria-labelledby="room-guide">
      <span class="section-label">GOOD TO KNOW</span>
      <h2 id="room-guide">객실 이용 안내</h2>
      <div class="amenities">
        {['온돌 침구', '객실 주방', '냉장고', 'TV', '에어컨'].map((label) => (
          <span>
            <Icon name="check" size={14} />
            {label}
          </span>
        ))}
      </div>
      <ul class="detail-list">
        <li>
          <strong>인원 안내</strong>
          <span>
            기준 {room.standard}인, 최대 {room.maximum}인입니다. 유아·어린이 인원 기준과 추가 요금은
            예약 시 확인해 주세요.
          </span>
        </li>
        <li>
          <strong>입실 안내</strong>
          <span>오후 3시부터 입실하실 수 있습니다. 늦은 도착은 미리 전화로 알려주세요.</span>
        </li>
        <li>
          <strong>퇴실 안내</strong>
          <span>퇴실은 오전 11시입니다. 사용하신 공간을 정리해 주시면 감사하겠습니다.</span>
        </li>
        <li>
          <strong>바비큐</strong>
          <span>이용 가능 여부와 준비 비용은 방문 전에 전화로 문의해 주세요.</span>
        </li>
        <li>
          <strong>차량 방문</strong>
          <span>출발 전 펜션에 연락해 차량 진입과 주차 안내를 확인해 주세요.</span>
        </li>
      </ul>
      <a class="text-link" style="margin-top:22px" href="/guide/">
        전체 이용 안내
        <Icon name="arrow" size={17} />
      </a>
      <div class="room-story">
        <p>{room.story}</p>
        <small>
          객실 이름에 담은 화양구곡 이야기입니다. 객실에서 보이는 전망을 뜻하지 않습니다.
        </small>
      </div>
    </section>
    <section class="other-rooms">
      <div class="section-heading">
        <div>
          <span class="section-label">EXPLORE OTHER ROOMS</span>
          <h2>다른 객실 둘러보기</h2>
        </div>
        <a class="text-link" href="/rooms/">
          전체 객실
          <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="other-room-links">
        {rooms
          .filter((r) => r.slug !== room.slug)
          .map((other) => (
            <a href={`/rooms/${other.slug}/`}>
              <Photo name={other.cover as keyof typeof images} sizes="120px" />
              <div>
                <h3>{other.name}</h3>
                <p>
                  기준 {other.standard}인 · 최대 {other.maximum}인
                </p>
              </div>
              <Icon name="diagonal" size={19} />
            </a>
          ))}
      </div>
    </section>
  </div>
</Layout>
