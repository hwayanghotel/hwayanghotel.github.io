---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import RoomCard from '../components/RoomCard.astro';
import Faq from '../components/Faq.astro';
import BookingBanner from '../components/BookingBanner.astro';
import { rooms, site } from '../data/site';
---

<Layout immersive>
  <section class="landscape-hero home-hero" aria-labelledby="home-title">
    <Photo
      name="valley-landscape"
      alt="화양계곡의 숲과 흰 바위 사이로 흐르는 물"
      mobileName="quiet-creek"
      mobileSizes="800px"
      class="hero-background"
      priority
      sizes="100vw"
    />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <p class="hero-kicker">충북 괴산 · 화양계곡의 풍경</p>
      <h1 id="home-title">
        계곡 곁에서
        <br />
        보내는 하루.
      </h1>
      <div class="hero-bottom">
        <p>
          머물고, 함께 먹고, 천천히 걷는 곳.
          <br class="mobile-only" /> 화양계곡 능운대입니다.
        </p>
        <a href="#discover" class="hero-scroll">
          능운대 둘러보기 <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>
  <nav class="quick-links container" aria-label="예약과 방문 안내">
    <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
      <span>
        <small>STAY</small>
        <strong>숙박 예약</strong>
      </span>
      <span class="quick-note">날짜별 요금 · 빈 객실 확인</span>
      <Icon name="diagonal" />
      <span class="sr-only">(새 창)</span>
    </a>
    <a href={site.phoneHref}>
      <span>
        <small>DINING</small>
        <strong>식사 전화 예약</strong>
      </span>
      <span class="quick-note">{site.phone}</span>
      <Icon name="diagonal" />
    </a>
    <a href="/visit/">
      <span>
        <small>VISIT</small>
        <strong>오시는 길</strong>
      </span>
      <span class="quick-note">차량 진입 · 주차 안내</span>
      <Icon name="arrow" />
    </a>
  </nav>
  <section class="container introduction section" id="discover" aria-labelledby="intro-title">
    <div class="intro-copy">
      <span class="eyebrow">HWAYANG VALLEY, NEUNGUNDAE</span>
      <h2 id="intro-title">
        화양계곡에 자리한
        <br />
        작은 펜션과 식당.
      </h2>
      <p>
        숲과 바위 사이로 흐르는 계곡,
        <br />그 곁에 능운대의 네 객실과 식탁이 있습니다.
        <br />
        가족과 친구, 함께 온 사람들과 하루를 보내세요.
      </p>
      <a class="text-link" href="/visit/">
        능운대 찾아오기 <Icon name="arrow" />
      </a>
    </div>
    <figure class="intro-photo">
      <Photo name="exterior" sizes="(max-width:700px) 90vw, 48vw" />
      <figcaption>초록 지붕 아래, 능운대펜션</figcaption>
    </figure>
  </section>
  <section class="container section rooms-home" aria-labelledby="rooms-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">01 / STAY</span>
        <h2 id="rooms-heading">우리에게 맞는 방.</h2>
      </div>
      <a class="text-link" href="/rooms/">
        객실 전체 보기 <Icon name="arrow" />
      </a>
    </div>
    <div class="room-grid">
      {rooms.map((room) => (
        <RoomCard room={room} />
      ))}
    </div>
    <div class="rooms-footnote">
      <p>네 개의 온돌 객실. 함께 오는 인원과 필요한 공간에 맞춰 골라보세요.</p>
      <span>입실 15:00 &nbsp; / &nbsp; 퇴실 11:00</span>
    </div>
  </section>
  <section class="landscape-feature" aria-labelledby="nature-heading">
    <Photo name="forest-path" sizes="(max-width: 600px) 850px, 100vw" />
    <div class="landscape-feature-shade"></div>
    <div class="container landscape-feature-copy">
      <span class="eyebrow">02 / WALK</span>
      <h2 id="nature-heading">
        나무 그늘을 따라,
        <br />
        화양의 산책.
      </h2>
      <a class="text-link" href="/valley/">
        계곡과 산책 둘러보기 <Icon name="arrow" />
      </a>
    </div>
  </section>
  <section class="container section home-dining" aria-labelledby="dining-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">03 / DINING</span>
        <h2 id="dining-heading">함께 나누는 한 상.</h2>
      </div>
      <a class="text-link" href="/dining/">
        식당과 메뉴 보기 <Icon name="arrow" />
      </a>
    </div>
    <div class="food-editorial">
      <figure class="food-main">
        <Photo name="dining-table" sizes="(max-width:700px) 100vw, 65vw" />
        <figcaption>더덕구이 · 파전 · 도토리묵</figcaption>
      </figure>
      <div class="food-side">
        <Photo name="deodeok" sizes="(max-width:700px) 40vw, 30vw" />
        <div>
          <h3>
            산책 후에는,
            <br />
            든든한 한 끼.
          </h3>
          <p>
            백숙과 버섯찌개, 더덕구이와 파전.
            <br />
            방문 날짜와 인원, 메뉴를 전화로 알려주세요.
          </p>
          <a class="text-link" href={site.phoneHref}>
            식사 예약 {site.phone} <Icon name="diagonal" size={17} />
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="container section faq-layout" aria-labelledby="faq-heading">
    <div class="faq-heading">
      <span class="eyebrow">BEFORE YOUR VISIT</span>
      <h2 id="faq-heading">
        방문 전에
        <br />
        알아두세요.
      </h2>
      <a class="text-link" href="/guide/">
        이용 안내 전체 보기 <Icon name="arrow" />
      </a>
    </div>
    <Faq limit={4} />
  </section>
  <BookingBanner />
</Layout>
