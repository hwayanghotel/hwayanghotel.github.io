---
import Button from './Button.astro';
import { site } from '../data/site';
---

<section class="booking-banner">
  <div class="container booking-banner-inner">
    <div>
      <span class="eyebrow">STAY AT NEUNGUNDAE</span>
      <h2>머무를 날을 골라보세요.</h2>
      <p>날짜별 객실 요금과 예약 가능 여부를 확인하실 수 있습니다.</p>
    </div>
    <div class="booking-banner-actions">
      <Button href={site.bookingUrl} variant="light" icon="diagonal" external>
        숙박 예약하기
      </Button>
      <a href={site.phoneHref}>식사 예약 · 문의 {site.phone}</a>
    </div>
  </div>
</section>
